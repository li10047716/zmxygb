# ============================================================
# 造梦改版 - .gitignore
# 设计原则：源码入库，二进制/下载物/缓存不入库
# ============================================================

# ---------- 可执行文件 / 下载物（体积大，不入库） ----------
*.exe
*.zip
*.rar
*.7z
*.iso

# ---------- Flash SWF 资源（编译产物，非源码） ----------
*.swf

# ---------- git 打包文件（克隆本仓库即可取代，无需入库） ----------
zmxygb-bundle.bundle
*.bundle

# ---------- Godot 引擎缓存与导出产物 ----------
godot/
*.tmp
godot-home/
godot-run/
godot-empty/
godot-simple/

# ---------- 系统垃圾文件 ----------
Thumbs.db
desktop.ini
.DS_Store
*.log

# ---------- 编辑器/IDE 配置 ----------
.vscode/
.idea/
*.swp
